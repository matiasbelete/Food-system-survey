# ============================================================
# SCF-EAT Survey Platform — Root .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment / Secrets ────────────────────────────────────
# NEVER commit credentials or secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Backend: uploaded files ──────────────────────────────────
# User-uploaded files should not be in version control
backend/uploads/*
!backend/uploads/.gitkeep

# ── Frontend: production build ───────────────────────────────
frontend/build/

# ── Testing / Coverage ───────────────────────────────────────
coverage/
frontend/coverage/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── OS generated files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ─────────────────────────────────────────────────────
.cache/
.parcel-cache/
dist/
tmp/
temp/
